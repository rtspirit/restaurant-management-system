# Copy to .env.local and fill in. .env.local is git-ignored. Never commit real values.

# OpenRouter: one key covers the build agent, the Ask agent and embeddings (ADR 0007)
OPENROUTER_API_KEY=
# Where model calls go. Change only to switch gateway.
RMS_LLM_BASE_URL=https://openrouter.ai/api/v1

# Model names as the gateway lists them. Set from current docs at setup (see docs/reference/verified-apis.md). Never hard-code in source.
RMS_BUILD_MODEL=
RMS_ASK_MODEL=
RMS_EMBED_MODEL=

# Supabase: personal project only. The ref must match .rms/supabase-project
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Pooler connection strings (not the direct address)
DATABASE_URL=
SUPABASE_DB_PASSWORD=

# Signing key for RMS app, run and preview tokens (generate with: openssl rand -base64 48)
RMS_TOKEN_SECRET=

# Server logins. DATABASE_URL = rms_api (restaurant-facing, row-level security by org).
# DATABASE_ADMIN_URL = rms_admin (sign-up, provisioning, jobs, maintainer console).
# Local values are written by scripts/dev-db-roles.sh
DATABASE_ADMIN_URL=
# host:port the Ask query tool connects to as the per-restaurant ask login
ASK_DATABASE_HOST=

# Browser-visible settings (safe to expose) and service addresses
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=
API_URL=
WEB_URL=
ADMIN_URL=
# The only sites the web app may show in a frame (read when the web app is BUILT).
# PREVIEW_URL: where build previews are served from (exact addresses, comma-separated).
# APPS_URL: the apps host for published mini-apps, the separate server that hands out their
#   files (local port 3002). It must be a different HOST from WEB_URL, not only a different
#   port, because cookies ignore the port (ADR 0012). On the laptop:
#   WEB_URL=http://127.0.0.1:3000 and APPS_URL=http://localhost:3002.
#   NEXT_PUBLIC_APPS_URL is the same address, for the web app's own check before it loads a frame.
# PREVIEW_FRAME_SUFFIX: the domain build sandboxes get their addresses under (a domain, no scheme).
PREVIEW_URL=
APPS_URL=
NEXT_PUBLIC_APPS_URL=
PREVIEW_FRAME_SUFFIX=
# Laptop-and-phone demo only (scripts/demo-phone.sh sets these). RMS_LOCAL_DEMO=1 allows plain
# http for the EXACT origins in RMS_LOCAL_DEMO_ORIGINS (comma-separated, no patterns) and for
# nothing else. The NEXT_PUBLIC_ copies are for the web app's build. Leave all four empty
# everywhere else. A deployed server ignores them.
RMS_LOCAL_DEMO=
RMS_LOCAL_DEMO_ORIGINS=
NEXT_PUBLIC_RMS_LOCAL_DEMO=
NEXT_PUBLIC_RMS_LOCAL_DEMO_ORIGINS=

# Password for the demo sign-ins created by the reset command. 10+ characters. Never commit a real value.
DEMO_PASSWORD=
