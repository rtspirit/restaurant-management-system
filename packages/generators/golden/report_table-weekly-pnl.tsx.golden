// Made by `rms gen report_table` for the report weekly_pnl. Editable: change anything in this file.
import { addDays, dateFromToday, formatAs, formatDate, useNamedQuery, useRms } from "@rms/sdk";
import { Page, Pager, ReportTable, Skeleton, Stack } from "@rms/ui";
import { useState } from "react";
import { NoNumbers, Problem } from "../../rms/notices";

const QUERY = "weekly_pnl";
const COLUMNS = [{ key: "section", label: "Section", format: "text", align: "start" }, { key: "account_code", label: "Account number", format: "text", align: "start" }, { key: "account_name", label: "Account", format: "text", align: "start" }, { key: "amount", label: "Amount", format: "money", align: "end" }, { key: "pct_of_net_sales", label: "Share of net sales (%)", format: "percent", align: "end" }, { key: "stock_counted", label: "Stock counted this week", format: "text", align: "start" }] as const;

export function PnlScreen() {
  const rms = useRms();
  const [weekOf, setWeekOf] = useState(() => dateFromToday(-7));
  const report = useNamedQuery(QUERY, { "week_of": weekOf });

  return (
    <Page title="Profit and loss" actions={<Pager label={`Week of ${formatDate(weekOf, rms.locale)}`} previousLabel="Week before" nextLabel="Week after" onPrevious={() => setWeekOf((d) => addDays(d, -7))} onNext={() => setWeekOf((d) => addDays(d, 7))} />}>
      <Stack gap="m">
        <Problem error={report.error} />
        {report.loading && report.data === null ? (
          <Skeleton shape="block" label="Loading the report" />
        ) : report.rows.length === 0 ? (
          <NoNumbers what="weekly profit and loss" />
        ) : (
          <ReportTable
            title="Weekly profit and loss"
            source="From your books: weekly profit and loss."
            columns={COLUMNS.map((c) => ({ key: c.key, label: c.label, align: c.align }))}
            rows={report.rows.map((row, i) => ({ id: String(i), cells: Object.fromEntries(COLUMNS.map((c) => [c.key, formatAs(row[c.key], c.format, rms)])) }))}
          />
        )}
      </Stack>
    </Page>
  );
}
