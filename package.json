{
  "name": "rms",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:security": "vitest run --config vitest.security.config.ts",
    "preflight:vercel": "scripts/preflight-vercel.sh",
    "reset-demo": "pnpm --filter @rms/seed reset-demo",
    "c1-walkthrough": "pnpm --filter @rms/seed exec tsx ../../scripts/c1-walkthrough.mts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@rms/auth": "workspace:*",
    "@rms/contracts": "workspace:*",
    "@rms/db": "workspace:*",
    "@rms/models": "workspace:*",
    "@types/node": "26.6.6",
    "hono": "4.13.19",
    "supabase": "3.2.0",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
